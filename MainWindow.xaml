<Window x:Class="AppFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppFlow" Icon="/Assets/AppFlowLogo.png" Height="670" Width="1020" MinHeight="580" MinWidth="820"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource MainText}"
        WindowStartupLocation="CenterScreen" StateChanged="Window_StateChanged" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#151619" BorderBrush="#2A2C31" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Margin="8,7,0,22">
            <Image Source="/Assets/AppFlowLogo.png" Width="58" Height="58" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="APPFLOW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
          </StackPanel>
          <Button x:Name="ProfilesNav" Content="Profiles" HorizontalContentAlignment="Left" Click="ShowProfiles"/>
          <Button x:Name="AppsNav" Content="Applications" HorizontalContentAlignment="Left" Click="ShowApps"/>
          <Button x:Name="SettingsNav" Content="Settings" HorizontalContentAlignment="Left" Click="ShowSettings"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,5">
          <TextBlock x:Name="MonitorStatus" Text="Starting monitor..." Foreground="#A5DAB2" TextWrapping="Wrap"/>
          <TextBlock Text="Your data stays on this PC." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30,26,30,24">
      <Grid x:Name="ProfilesPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left">
            <TextBlock Text="Profiles" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Choose what AppFlow opens when an app starts." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="New profile" Style="{StaticResource PrimaryButton}" Click="NewProfile"/>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
          <DockPanel LastChildFill="False">
            <CheckBox x:Name="PauseToggle" Content="Pause automation" VerticalAlignment="Center" Checked="PauseChanged" Unchecked="PauseChanged"/>
            <TextBlock x:Name="MonitorDetail" Text="Watching for trigger apps" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Grid Grid.Row="2">
          <ListBox x:Name="ProfileList" SelectionChanged="ProfileSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TriggerName, StringFormat=Trigger: {0}}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Content="Enabled" Click="ProfileEnabledChanged"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ProfileEmptyText" Text="No profiles yet. Choose New profile to create your first one." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="EditProfileButton" Content="Edit profile" Click="EditProfile" IsEnabled="False"/>
          <Button x:Name="DuplicateButton" Content="Duplicate" Click="DuplicateProfile" IsEnabled="False"/>
          <Button x:Name="DeleteProfileButton" Content="Delete" Click="DeleteProfile" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="AppsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
          <TextBlock Text="Applications" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Search installed apps or add an executable or shortcut." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0" MaxWidth="460" HorizontalAlignment="Left">
            <TextBox x:Name="SearchBox" TextChanged="SearchChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search by app name or path" Foreground="#A0A3AB" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Refresh" Click="RefreshApplications"/>
            <Button Content="Add application" Style="{StaticResource PrimaryButton}" Click="AddApplication"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
          <ListBox x:Name="AppList" SelectionChanged="AppSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image Source="{Binding IconSource}" Width="24" Height="24" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="3,0,10,0">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="AppsEmptyText" Text="No applications found. Use Add application to choose an .exe file or shortcut." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="EditApplicationButton" Content="Edit details" Click="EditApplication" IsEnabled="False"/>
          <Button x:Name="RemoveApplicationButton" Content="Remove from library" Click="RemoveApplication" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/>
          <TextBlock Text="Set how AppFlow starts and reports activity." Foreground="{StaticResource Muted}" Margin="0,4,0,22"/>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
              <CheckBox x:Name="StartupToggle" Content="Start AppFlow when I sign in" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="MinimizedToggle" Content="Start hidden in the system tray" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <CheckBox x:Name="NotifyToggle" Content="Show notifications when apps are opened" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <TextBlock Text="Default delay between companion apps (milliseconds)" Foreground="#D2D3D8" Margin="4,20,0,7"/>
              <TextBox x:Name="DelayBox" Width="150" HorizontalAlignment="Left" Text="1000" TextChanged="SettingsChanged"/>
              <TextBlock Text="Minimizing or closing the window sends AppFlow to the tray. Right-click its tray icon and choose Exit to stop it." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,18,8,4"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="App updates" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Check for AppFlow updates from its GitHub releases." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
              <DockPanel LastChildFill="False">
                <TextBlock x:Name="UpdateStatusText" Text="Updates are checked when AppFlow starts." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckForUpdatesClicked"/>
                  <Button x:Name="ApplyUpdateButton" Content="Restart to update" Style="{StaticResource PrimaryButton}" Click="ApplyUpdateClicked" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>

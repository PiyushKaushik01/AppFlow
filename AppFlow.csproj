<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\AppFlow.ico</ApplicationIcon>
    <StartupObject>AppFlow.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
    <Page Remove="artifacts/**/*.xaml" />
    <ApplicationDefinition Remove="artifacts/**/*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppFlowLogo.png" />
    <Resource Include="Assets\AppFlow.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(GitHubRepositoryUrl)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GitHubRepositoryUrl</_Parameter1>
      <_Parameter2>$(GitHubRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
